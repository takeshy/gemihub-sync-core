{
  "name": "gemihub-sync-core",
  "version": "0.3.0",
  "description": "Shared sync protocol core for GemiHub clients — _sync-meta.json diffing, conflict detection and Drive helpers for the web app, Obsidian and Desktop plugins.",
  "license": "MIT",
  "author": "Takeshi Morita",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "protocol": [
        "./dist/protocol/index.d.ts"
      ],
      "paths": [
        "./dist/paths/index.d.ts"
      ],
      "files": [
        "./dist/files/index.d.ts"
      ],
      "conflict": [
        "./dist/conflict/index.d.ts"
      ],
      "crypto": [
        "./dist/crypto/index.d.ts"
      ],
      "auth": [
        "./dist/auth/index.d.ts"
      ],
      "hash": [
        "./dist/hash/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./paths": {
      "types": "./dist/paths/index.d.ts",
      "default": "./dist/paths/index.js"
    },
    "./files": {
      "types": "./dist/files/index.d.ts",
      "default": "./dist/files/index.js"
    },
    "./conflict": {
      "types": "./dist/conflict/index.d.ts",
      "default": "./dist/conflict/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "default": "./dist/crypto/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./hash": {
      "types": "./dist/hash/index.d.ts",
      "default": "./dist/hash/index.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepare": "npm run build",
    "prepack": "npm run build && npm test",
    "sync-plugins": "node scripts/sync-plugins.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^5.9.3"
  }
}
